# SahAI API Environment Configuration
SAHAI_DEMO_MODE=true
SAHAI_ENV=development

# Database: Defaults to SQLite fallback when PostgreSQL is not running
# For PostgreSQL 16: postgresql+psycopg2://sahai_user:sahai_password@localhost:5432/sahai_db
DATABASE_URL=sqlite:///./sahai.db

# Authentication & Security
SECRET_KEY=sahai_demo_secret_key_not_for_production_89437291847
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging & Telemetry
LOG_LEVEL=INFO
